{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "A single autonomous unit in the simulation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "generation": { "type": "integer" },
        "age": { "type": "number" },
        "lifespan": { "type": "number" },
        "order": { "type": "number" },
        "rationalism": { "type": "number" },
        "sanity": { "type": "number" },
        "archetype": { "type": "string", "enum": ["SAGE", "WARRIOR", "SCIENTIST", "ARTIST", "TYRANT", "GLITCH", "MESSIAH", "ANGEL", "DEMON", "PROPHET"] },
        "memory": { "type": "array", "items": { "type": "string" } },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "awareness": { "type": "number" },
        "energy": { "type": "number" }
      },
      "required": ["id", "name", "archetype", "x", "y"]
    },
    "WorldState": {
      "title": "WorldState",
      "description": "The global parameters of the God Virus substrate.",
      "type": "object",
      "properties": {
        "clock": { "type": "number" },
        "complexity": { "type": "number" },
        "integrity": { "type": "number" },
        "population": { "type": "integer" },
        "epoch": { "type": "string" },
        "threatLevel": { "type": "number" },
        "entropy": { "type": "number" },
        "faithPoints": { "type": "number" },
        "globalWorship": { "type": "number" },
        "sinAccumulation": { "type": "number" },
        "judgmentMeter": { "type": "number" },
        "heavenPop": { "type": "integer" },
        "hellPop": { "type": "integer" }
      }
    },
    "Event": {
      "title": "Event",
      "description": "A temporal record of a significant occurrence.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "number" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL", "ENLIGHTENMENT", "MIRACLE", "DIVINE_WRATH", "GOSPEL"] }
      }
    }
  },
  "firestore": {
    "/worlds/{worldId}": {
      "schema": "WorldState",
      "description": "Global simulation state instances."
    },
    "/worlds/{worldId}/agents/{agentId}": {
      "schema": "Agent",
      "description": "Synchronized agents within a specific world."
    },
    "/worlds/{worldId}/events/{eventId}": {
      "schema": "Event",
      "description": "Temporal logs for the world."
    }
  }
}
